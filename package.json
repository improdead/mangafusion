{
  "name": "mangafusion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma || exit 0",
    "install:all": "npm install && cd backend && npm install",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --name init --schema backend/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.16.0",
    "@nestjs/common": "^10.4.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@prisma/client": "^5.16.2",
    "@sentry/nextjs": "^10.25.0",
    "@sentry/node": "^10.25.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.5",
    "fabric": "^6.9.0",
    "formidable": "^3.5.2",
    "next": "^15.5.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.66",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5"
  }
}
