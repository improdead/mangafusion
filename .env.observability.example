# ===========================================
# OBSERVABILITY CONFIGURATION
# ===========================================
# Copy these to your .env file and configure

# Enable observability (Sentry + OpenTelemetry + Logging)
# Set to 'true' in production, 'false' in development to reduce noise
ENABLE_OBSERVABILITY=false
NEXT_PUBLIC_ENABLE_OBSERVABILITY=false

# ===========================================
# SENTRY CONFIGURATION
# ===========================================

# Sentry DSN for backend (NestJS)
# Get this from https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
SENTRY_DSN=https://your-public-key@your-org.ingest.sentry.io/your-project-id

# Sentry DSN for frontend (Next.js) - can be the same as backend or different project
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@your-org.ingest.sentry.io/your-project-id

# Sentry release tracking (optional - useful for tracking which version has errors)
# Can use git commit hash or version number
SENTRY_RELEASE=mangafusion@0.1.0
NEXT_PUBLIC_SENTRY_RELEASE=mangafusion@0.1.0

# Sentry Auth Token (needed for source maps upload - optional)
# SENTRY_AUTH_TOKEN=your-auth-token-here

# ===========================================
# OPENTELEMETRY CONFIGURATION
# ===========================================

# OTLP Exporter endpoint - where to send traces
# Examples:
# - Jaeger: http://localhost:14268/api/traces
# - Zipkin: http://localhost:9411/api/v2/spans
# - OTLP HTTP: http://localhost:4318/v1/traces
# - Honeycomb: https://api.honeycomb.io/v1/traces
# - Grafana Cloud: https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# OTLP Headers (for authentication, e.g., Honeycomb or Grafana Cloud)
# Format: JSON string with headers
# Example for Honeycomb: {"x-honeycomb-team":"your-api-key"}
# Example for Grafana: {"Authorization":"Basic your-base64-credentials"}
OTEL_EXPORTER_OTLP_HEADERS={}

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Log level: 'error' | 'warn' | 'info' | 'debug' | 'trace'
# Recommended: 'info' for production, 'debug' for development
LOG_LEVEL=info

# ===========================================
# COST TRACKING
# ===========================================
# Enable detailed cost tracking for AI API usage
ENABLE_COST_TRACKING=true

# ===========================================
# PLANNER SERVICE CONFIGURATION (for observability)
# ===========================================

# Enable stub fallback if planner fails (default: true)
PLANNER_ENABLE_STUB_FALLBACK=true

# Enable partial merge with stub data (default: true)
PLANNER_ENABLE_PARTIAL_MERGE=true

# Max retries for planner API calls
PLANNER_MAX_RETRIES=3

# Initial delay between retries (ms)
PLANNER_INITIAL_DELAY_MS=1000

# Max delay between retries (ms)
PLANNER_MAX_DELAY_MS=10000

# Backoff multiplier for retries
PLANNER_BACKOFF_MULTIPLIER=2

# ===========================================
# ALERT THRESHOLDS (for custom monitoring)
# ===========================================

# Alert if planning takes longer than this (ms)
ALERT_THRESHOLD_PLANNING_MS=60000

# Alert if page generation takes longer than this (ms)
ALERT_THRESHOLD_PAGE_GEN_MS=90000

# Alert if error rate exceeds this percentage
ALERT_THRESHOLD_ERROR_RATE_PCT=5

# ===========================================
# NOTES
# ===========================================
#
# 1. SENTRY SETUP:
#    - Create account at sentry.io
#    - Create new project for backend and/or frontend
#    - Copy DSN from project settings
#
# 2. OPENTELEMETRY SETUP:
#    - Run local Jaeger: docker run -d -p 16686:16686 -p 14268:14268 jaegertracing/all-in-one:latest
#    - Access Jaeger UI at http://localhost:16686
#    - OR use Grafana Cloud, Honeycomb, Datadog, etc.
#
# 3. PRODUCTION RECOMMENDATIONS:
#    - Set ENABLE_OBSERVABILITY=true
#    - Use production Sentry project with appropriate rate limits
#    - Configure OTLP to send to production tracing backend
#    - Set LOG_LEVEL=info or warn
#    - Enable cost tracking to monitor AI API expenses
