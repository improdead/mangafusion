# ==========================================
# BullMQ + Redis Queue Configuration
# ==========================================

# Redis connection string (REQUIRED for queue to work)
REDIS_URL=redis://localhost:6379

# Worker concurrency settings
WORKER_CONCURRENCY_PAGES=2
WORKER_CONCURRENCY_CHARACTERS=1

# Existing environment variables (still needed)
DATABASE_URL=postgresql://user:password@localhost:5432/mangafusion
GEMINI_API_KEY=your_gemini_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here

# Renderer configuration
RENDERER_PROVIDER=gemini
RENDERER_GEMINI_MODEL=gemini-2.0-flash-exp
RENDERER_OPENAI_MODEL=gpt-image-1

# Storage (optional but recommended)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=manga-images
