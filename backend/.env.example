# Backend environment example
# Copy to .env (do not commit) and set values, or export in your shell.

# ========================================
# AI Provider Configuration
# ========================================
# Choose your AI provider: 'openai' or 'gemini'
PLANNER_PROVIDER=openai
RENDERER_PROVIDER=openai

# ========================================
# OpenAI Configuration (Recommended)
# ========================================
OPENAI_API_KEY=
# Story planning model (defaults to gpt-5-mini)
OPENAI_PLANNER_MODEL=gpt-5-mini
# Image generation model (defaults to gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1

# ========================================
# Gemini Configuration (Alternative)
# ========================================
GEMINI_API_KEY=
# Story planning model (defaults to gemini-2.5-flash)
PLANNER_MODEL=gemini-2.5-flash
# Image generation model (defaults to gemini-2.5-flash-image-preview aka "Nano Banana")
RENDERER_IMAGE_MODEL=gemini-2.5-flash-image-preview

# ========================================
# Planner Hardening Configuration
# ========================================
# Retry configuration for planner API calls
PLANNER_MAX_RETRIES=3
PLANNER_INITIAL_DELAY_MS=1000
PLANNER_MAX_DELAY_MS=10000
PLANNER_BACKOFF_MULTIPLIER=2

# Fallback strategies when AI fails
PLANNER_ENABLE_STUB_FALLBACK=true
PLANNER_ENABLE_PARTIAL_MERGE=true

# Supabase Storage (required for real image generation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=manga-images

# Database & Queue (optional for scaffolding)
DATABASE_URL=postgresql://user:password@localhost:5432/mangafusion
REDIS_URL=redis://localhost:6379

# ElevenLabs TTS (for audiobook feature)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: override default voice ID (Adam voice)
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Optional: override TTS model (Flash v2.5 is faster and cheaper)
ELEVENLABS_MODEL=eleven_flash_v2_5

# Server config
PORT=4000
# Optional CORS origin override
# CORS_ORIGIN=http://localhost:3000

